# ─── 外部AIの利用（既定はすべて「使わない」）────────────────────
# true にすると、この設置環境では組織の設定に関わらず外部AIを一切呼ばない（自治体の閉域・オンプレ向け）
WHITEKNIGHT_AI_HARD_DISABLE=false
# この設置環境で許可する最大のモード: off | metadata_only | with_code
#   metadata_only = 「外部AIへコードを送らない」。不正な値は off として扱う
WHITEKNIGHT_AI_MAX_MODE=metadata_only
# AI を使う場合のみ（M4 以降）
ANTHROPIC_API_KEY=

# ─── 以下は M5 以降で使用 ──────────────────────────────────
# Neon の接続文字列。Vercel の環境変数に設定し、このファイルには書かない
DATABASE_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
WORKER_SHARED_SECRET=
